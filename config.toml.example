[general]
model_path = "data/models/best.pt"      # Path to YOLO ID card detection model
conf_threshold = 0.8                     # YOLO confidence threshold for person detection
loitering_threshold = 10.0              # Global default loitering threshold in seconds

[[sources]]
name = "Webcam"                          # Display name for this camera source
source = 0                               # 0 for default webcam, or path to video file
loitering_enabled = true                 # Enable loitering detection for this source
loitering_threshold = 5.0               # Per-source override (overrides general setting)
loitering_alert_limit = 1               # Max loitering alerts per person (1 = once only)
alert_limit_per_track = 5               # Max no_id alerts per tracked person per session
alert_cooldown = 10.0                    # Min seconds between no_id alerts for the same position
no_id_alert_distance = 150              # Max pixel distance to treat as same person for no_id dedup
process_every_n_frames = 3              # Run detection every Nth frame (1 = every frame)
tracker_reset_interval = 0              # Seconds between tracker resets (0 = never)
crowd_min_people = 5                     # Min people count to trigger crowd alert
crowd_min_duration = 15.0               # Seconds crowd must persist before alerting
loitering_windows = [
    { start = "18:00", end = "06:00" },  # Overnight window
    { start = "12:00", end = "13:00" }   # Lunch hour window
]

